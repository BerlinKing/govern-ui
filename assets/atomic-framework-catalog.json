        {
          "id": "style",
          "label": [
            "线型",
            "Style"
          ],
          "kind": "text",
          "example": "solid"
        },
        {
          "id": "offset",
          "label": [
            "轮廓偏移",
            "Outline offset"
          ],
          "kind": "length",
          "example": "0px"
        }
      ],
      "roles": [
        {
          "id": "border",
          "name": "--stroke-width-default",
          "label": [
            "常规边框",
            "Default border"
          ],
          "meaning": [
            "界定普通表面边界。",
            "Define ordinary surface boundaries."
          ],
          "location": [
            "输入框与面板",
            "Inputs and panels"
          ]
        },
        {
          "id": "divider",
          "name": "--stroke-width-divider",
          "label": [
            "分隔线",
            "Divider"
          ],
          "meaning": [
            "划分相邻内容。",
            "Divide adjacent content."
          ],
          "location": [
            "列表和区域分隔",
            "Lists and section dividers"
          ]
        },
        {
          "id": "focus",
          "name": "--stroke-focus",
          "label": [
            "焦点轮廓",
            "Focus outline"
          ],
          "meaning": [
            "让键盘焦点可识别。",
            "Make keyboard focus identifiable."
          ],
          "location": [
            "可聚焦控件",
            "Focusable controls"
          ]
        }
      ]
    },
    {
      "id": "radius",
      "label": [
        "圆角",
        "Radius"
      ],
      "description": [
        "定义形状转角的角色。",
        "Define corner-shape roles."
      ],
      "rule": [
        "按控件、容器和全圆角色复用；保留方角选项。",
        "Reuse control, container and pill roles; retain a square option."
      ],
      "fields": [
        {
          "id": "value",
          "label": [
            "圆角值",
            "Radius"
          ],
          "kind": "length",
          "example": "8px"
        }
      ],
      "roles": [
        {
          "id": "square",
          "name": "--radius-square",
          "label": [
            "方角",
            "Square"
          ],
          "meaning": [
            "明确的直角外形。",
            "An explicitly square shape."
          ],
          "location": [
            "方形表面",
            "Square surfaces"
          ]
        },
        {
          "id": "control",
          "name": "--radius-control",
          "label": [
            "控件圆角",
            "Control radius"
          ],
          "meaning": [
            "统一交互控件的转角。",
            "Unify corners of interactive controls."
          ],
          "location": [
            "按钮与输入框",
            "Buttons and inputs"
          ]
        },
        {
          "id": "container",
          "name": "--radius-container",
          "label": [
            "容器圆角",
            "Container radius"
          ],
          "meaning": [
            "定义内容容器转角。",
            "Define content-container corners."
          ],
          "location": [
            "卡片与面板",
            "Cards and panels"
          ]
        },
        {
          "id": "pill",
          "name": "--radius-pill",
          "label": [
            "全圆",
            "Pill"
          ],
          "meaning": [
            "胶囊或圆形轮廓。",
            "A pill or circular outline."
          ],
          "location": [
            "标签与圆形控件",
            "Tags and circular controls"
          ]
        }
      ]
    },
    {
      "id": "spacing",
      "label": [
        "间距与尺寸",
        "Spacing & sizing"
      ],
      "description": [
        "定义内边距、元素间隔和控件尺寸。",
        "Define insets, gaps and control dimensions."
      ],
      "rule": [
        "区分间隔、内部留白与交互尺寸；动态画布坐标不作为共享间距。",
        "Separate gaps, insets and interaction dimensions. Dynamic canvas coordinates are not shared spacing."
      ],
      "fields": [
        {
          "id": "value",
          "label": [
            "长度",
            "Length"
          ],
          "kind": "length",
          "example": "8px"
        }
      ],
      "roles": [
        {
          "id": "gap",
          "name": "--space-inline",
          "label": [
            "元素间隔",
            "Element gap"
