          "meaning": [
            "强调独立的模态内容。",
            "Emphasize modal content."
          ],
          "location": [
            "对话框",
            "Dialogs"
          ]
        }
      ]
    },
    {
      "id": "stroke",
      "label": [
        "描边",
        "Stroke"
      ],
      "description": [
        "定义边界线宽、线型与焦点轮廓。",
        "Define boundary width, style and focus outlines."
      ],
      "rule": [
        "边框和焦点轮廓分别定义；颜色通过颜色角色绑定。",
