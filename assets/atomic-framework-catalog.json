          "id": "light",
          "label": [
            "浅色主题",
            "Light theme"
          ],
          "kind": "color",
          "example": "#FFFFFF"
        },
        {
          "id": "dark",
          "label": [
            "深色主题",
            "Dark theme"
          ],
          "kind": "color",
          "example": "#121212"
        }
      ],
      "roles": [
        {
          "id": "surface",
          "name": "--bg-surface",
          "label": [
            "容器背景",
            "Container surface"
