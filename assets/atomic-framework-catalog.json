          "label": [
            "品牌颜色",
            "Brand color"
          ],
          "meaning": [
            "表达品牌识别。",
            "Express brand identity."
          ],
          "location": [
            "品牌强调区域",
            "Brand accents"
          ]
        },
        {
          "id": "feedback",
          "name": "--feedback-info",
          "label": [
            "反馈颜色",
            "Feedback color"
          ],
          "meaning": [
            "表达反馈语义；按需要细分成功、警告和错误。",
            "Express feedback; define success, warning and error roles as needed."
          ],
          "location": [
            "状态提示",
            "Status feedback"
          ]
        },
        {
          "id": "media",
          "name": "--on-media-content",
          "label": [
            "媒体上的内容",
            "On-media content"
          ],
          "meaning": [
            "保证内容在图片或视频上可读。",
            "Keep content readable on images or video."
          ],
          "location": [
            "媒体覆盖层",
            "Media overlays"
          ]
        },
        {
          "id": "data",
          "name": "--data-series-primary",
          "label": [
            "数据颜色",
            "Data color"
          ],
          "meaning": [
            "区分有数据含义的序列。",
            "Distinguish meaningful data series."
          ],
          "location": [
            "图表与数据视图",
            "Charts and data views"
          ]
        }
      ]
    },
    {
      "id": "typography",
      "label": [
        "字体排版",
        "Typography"
      ],
      "description": [
        "定义文字角色与完整排版组合。",
        "Define text roles and complete typography composites."
      ],
      "rule": [
        "字体、字号、字重、行高和字距一起确认；标题与正文不因字号相同而合并。",
        "Confirm family, size, weight, line height and tracking together. Equal sizes do not make headings and body text equivalent."
      ],
      "fields": [
        {
          "id": "family",
          "label": [
            "字体与回退",
            "Family and fallback"
          ],
          "kind": "text",
          "example": "system-ui, sans-serif"
        },
        {
          "id": "size",
          "label": [
            "字号",
            "Font size"
          ],
          "kind": "length",
          "example": "14px"
        },
        {
          "id": "weight",
          "label": [
            "字重",
            "Weight"
          ],
          "kind": "text",
          "example": "500"
        },
        {
          "id": "lineHeight",
          "label": [
            "行高",
            "Line height"
          ],
          "kind": "text",
          "example": "1.5"
        },
        {
          "id": "tracking",
          "label": [
            "字距",
            "Letter spacing"
          ],
          "kind": "length",
          "example": "0px"
        }
      ],
      "roles": [
        {
          "id": "heading",
          "name": "--type-heading",
          "label": [
            "标题",
            "Heading"
          ],
          "meaning": [
            "建立内容阅读层级。",
            "Establish content hierarchy."
          ],
          "location": [
            "页面与区域标题",
            "Page and section headings"
          ]
        },
        {
          "id": "body",
          "name": "--type-body",
          "label": [
            "正文",
            "Body"
          ],
          "meaning": [
            "支持连续阅读。",
            "Support continuous reading."
          ],
          "location": [
            "段落和主要内容",
            "Paragraphs and main content"
          ]
        },
        {
          "id": "label",
          "name": "--type-label",
          "label": [
            "控件标签",
            "Control label"
          ],
          "meaning": [
            "识别操作和输入内容。",
            "Identify actions and inputs."
          ],
          "location": [
            "按钮与表单标签",
            "Buttons and form labels"
          ]
        },
        {
          "id": "caption",
          "name": "--type-caption",
          "label": [
            "辅助说明",
            "Caption"
          ],
          "meaning": [
