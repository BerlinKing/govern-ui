            "Supplement primary content."
          ],
          "location": [
            "说明与元信息",
            "Captions and metadata"
          ]
        },
        {
          "id": "code",
          "name": "--type-code",
          "label": [
            "代码与等宽内容",
            "Code"
          ],
          "meaning": [
            "表达需要等宽对齐的内容。",
            "Present content needing monospace alignment."
          ],
          "location": [
            "代码或结构化文本",
            "Code and structured text"
          ]
        }
      ]
    },
    {
      "id": "icons",
      "label": [
        "图标",
        "Icons"
      ],
      "description": [
        "定义图标来源、语义和几何规则。",
        "Define icon sources, semantics and geometry."
      ],
      "rule": [
        "保持同一视觉家族；图标尺寸与点击区域分开。图标颜色引用颜色框架。",
        "Keep a consistent visual family. Separate icon geometry from the hit target; use Color roles for color."
      ],
      "fields": [
        {
          "id": "source",
          "label": [
            "图标库或资源",
            "Package or asset"
          ],
          "kind": "text",
          "example": "package/export or asset.svg"
        },
        {
          "id": "size",
          "label": [
            "标称尺寸",
            "Nominal size"
          ],
          "kind": "length",
          "example": "16px"
        },
        {
          "id": "stroke",
          "label": [
            "笔画规则",
            "Stroke rule"
          ],
          "kind": "text",
          "example": "1.5px / filled"
        }
      ],
      "roles": [
        {
          "id": "navigation",
          "name": "--icon-navigation",
          "label": [
            "导航图标",
            "Navigation icon"
