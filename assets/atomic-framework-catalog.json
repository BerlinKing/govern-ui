          ]
        },
        {
          "id": "icon-disabled",
          "name": "--icon-disabled",
          "label": [
            "禁用图标色",
            "Disabled icon color"
          ],
          "meaning": [
            "不可操作图标的颜色。",
            "Color of unavailable icons."
          ],
          "location": [
            "禁用图标",
            "Disabled icons"
