            "Navigation and menus"
          ]
        },
        {
          "id": "action",
          "name": "--icon-action",
          "label": [
            "操作图标",
            "Action icon"
          ],
          "meaning": [
            "表达具体操作含义。",
            "Express an action."
          ],
          "location": [
            "工具栏和图标按钮",
            "Toolbars and icon buttons"
          ]
        },
        {
          "id": "status",
          "name": "--icon-status",
          "label": [
            "状态图标",
            "Status icon"
          ],
          "meaning": [
            "辅助区分反馈状态。",
            "Help distinguish feedback states."
          ],
          "location": [
            "成功、警告、错误提示",
            "Success, warning and error feedback"
          ]
        }
      ]
    },
    {
      "id": "shadow",
      "label": [
        "投影",
        "Shadow"
      ],
      "description": [
        "定义表面深度与浮起关系。",
        "Define surface depth and elevation."
      ],
      "rule": [
        "保存完整的偏移、模糊、扩散和颜色表达式；无投影也是明确选择。",
        "Keep complete offsets, blur, spread and color expressions. No shadow is an explicit choice."
      ],
      "fields": [
        {
          "id": "value",
          "label": [
            "完整投影",
            "Complete shadow"
          ],
          "kind": "css",
          "example": "0 4px 14px rgb(0 0 0 / 0.22)"
        }
      ],
      "roles": [
        {
          "id": "none",
          "name": "--shadow-none",
          "label": [
            "无投影",
            "No shadow"
          ],
          "meaning": [
            "表面无需额外深度提示。",
            "A surface needs no depth cue."
          ],
          "location": [
            "平面容器",
            "Flat containers"
          ]
        },
        {
          "id": "floating",
          "name": "--shadow-floating",
          "label": [
            "浮动表面",
