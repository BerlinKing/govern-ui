          "meaning": [
            "承载一组内容的基础表面。",
            "Base surface for a group of content."
          ],
          "location": [
            "卡片、面板、控件底板",
            "Cards, panels and control surfaces"
          ]
        },
        {
          "id": "body",
          "name": "--bg-body",
          "label": [
            "页面背景",
            "Page background"
