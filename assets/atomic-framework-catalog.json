      "fields": [
        {
          "id": "value",
          "label": [
            "透明度 0–1",
            "Opacity 0–1"
          ],
          "kind": "opacity",
          "example": "0.4"
        }
      ],
      "roles": [
        {
          "id": "disabled",
          "name": "--opacity-disabled",
          "label": [
            "禁用弱化",
            "Disabled treatment"
          ],
          "meaning": [
            "弱化不可交互的内容。",
            "De-emphasize unavailable content."
          ],
          "location": [
            "禁用图形或控件",
            "Disabled graphics or controls"
          ]
        },
        {
          "id": "scrim",
          "name": "--opacity-scrim",
          "label": [
            "遮罩透明度",
            "Scrim opacity"
