          "location": [
            "模态遮罩",
            "Modal backdrops"
          ]
        },
        {
          "id": "decorative",
          "name": "--opacity-decorative",
          "label": [
            "装饰透明度",
            "Decorative opacity"
          ],
          "meaning": [
